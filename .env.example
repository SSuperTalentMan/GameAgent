# GameAgent 环境配置（本机真实服务）
# 注意：API_KEY 从系统环境变量读取，不写入此文件。

# --- MySQL (小皮面板管理) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请填写本机值
MYSQL_DATABASE=gameagent

# --- Redis (Docker) ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=1

# --- Neo4j (Docker) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请填写本机值

# --- 编排参数 ---
MAX_FIX_ROUNDS=2
SIM_CONCURRENCY=10
SIM_SESSIONS_PER_PLAYER=3

# --- LLM ---
LLM_MODEL=qwen3.8-flash
LLM_FALLBACK_MODELS=qwen3.8-flash

# --- 万相文生图（额度已用尽，关闭；走程序化占位资产降级） ---
WANX_ENABLED=0
WANX_MODEL=wanx2.1-t2i-turbo

# --- H5 静态部署端口 ---
DEPLOY_PORT=8080

# --- Android 打包工具链 ---
ANDROID_SDK_ROOT=D:\GameAgent\tools\android-sdk
